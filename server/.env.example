# ===== AI — Primary: Groq =====
# Get a free key at https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_key_here
AI_ENABLED=true
AI_PRIMARY_PROVIDER=groq
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_REQUEST_LIMIT_PER_USER=3
AI_WEEKLY_PLAN_LIMIT_PER_USER=2
RULE_BASED_FALLBACK_ENABLED=true

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ===== AI — Fallback: Google Gemini =====
# Used only if GROQ_API_KEY is not set.
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Set to "true" to skip all AI calls and return a mock plan (useful for testing).
USE_MOCK_AI=false

# ===== Server =====
PORT=5000

# Supabase server-side session verification (use URL + publishable/anon key, never service_role)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated CORS origins. Defaults to http://localhost:5173.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ===== Email (optional) =====
# Contact form submissions go here. Defaults to curiolightforyou@gmail.com.
MAIL_TO=curiolightforyou@gmail.com

# OPTION A: Gmail with an app password (simplest)
#   1. Enable 2-step verification on the Google account
#   2. Generate an app password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-char password below
# GMAIL_USER=youraccount@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION B: any SMTP server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user
# SMTP_PASS=pass
# MAIL_FROM=noreply@your-domain.com

# Note: if neither option is configured, contact submissions are still saved
# to server/data/contact-submissions.json so nothing is lost.
CORS_ORIGINS=http://localhost:5173
